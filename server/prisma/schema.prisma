generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Seguridad / RBAC (Requisito 9 del documento de requerimientos)
// ---------------------------------------------------------------------------

enum RolNombre {
  ADMINISTRADOR
  DIRECTORIO
  CONSULTA
}

model Usuario {
  id              String    @id @default(uuid())
  nombre          String
  apellido        String
  email           String    @unique
  passwordHash    String
  rol             RolNombre
  activo          Boolean   @default(true)
  ultimoLogin     DateTime?

  copropietario   Copropietario? @relation(fields: [copropietarioId], references: [id])
  copropietarioId String?

  auditorias      HistorialAuditoria[]

  pagosRegistrados       Pago[]
  movimientosRegistrados MovimientoFinanciero[]
  nominasRegistradas     PagoPersonal[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Copropietarios / Inmuebles (Requisito 1 del documento de requerimientos)
// Base necesaria para que Backend 2 arranque "API Copropietarios e Inmuebles"
// la proxima semana sin bloquear el modelado.
// ---------------------------------------------------------------------------

model Copropietario {
  id          String   @id @default(uuid())
  nombre      String
  apellido    String
  ci          String   @unique
  email       String?
  telefono    String?

  usuarios    Usuario[]
  ocupaciones OcupanteInmueble[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("copropietarios")
}

model TipoInmueble {
  id          String     @id @default(uuid())
  nombre      String     @unique
  montoBase   Decimal    @db.Decimal(10, 2)

  inmuebles   Inmueble[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("tipos_inmueble")
}

model Inmueble {
  id             String       @id @default(uuid())
  codigo         String       @unique

  tipoInmueble   TipoInmueble @relation(fields: [tipoInmuebleId], references: [id])
  tipoInmuebleId String

  piso           String?
  areaM2         Decimal?     @db.Decimal(8, 2)
  activo         Boolean      @default(true)

  ocupaciones    OcupanteInmueble[]
  expensas       Expensa[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("inmuebles")
  @@index([tipoInmuebleId])
}

enum TipoValorMora {
  PORCENTAJE
  MONTO_FIJO
}

model ConfiguracionMora {
  id            String        @id @default(uuid())
  diaGeneracion Int           @default(1)
  diasGracia    Int           @default(0)
  tipoValor     TipoValorMora @default(PORCENTAJE)
  valor         Decimal       @db.Decimal(10, 2)
  vigenteDesde  DateTime      @default(now())

  @@map("configuracion_mora")
}

// Historial de ocupantes por departamento (propietario o inquilino, con fechas)
model OcupanteInmueble {
  id              String   @id @default(uuid())

  inmueble        Inmueble @relation(fields: [inmuebleId], references: [id])
  inmuebleId      String

  copropietario   Copropietario @relation(fields: [copropietarioId], references: [id])
  copropietarioId String

  esPropietario   Boolean  @default(true) // false = inquilino
  fechaInicio     DateTime @default(now())
  fechaFin        DateTime?

  @@map("ocupante_inmueble")
  @@index([inmuebleId])
  @@index([copropietarioId])
}

// ---------------------------------------------------------------------------
// Auditoria (Requisito 10 del documento de requerimientos)
// Registra quien, que accion, sobre que entidad y cuando.
// ---------------------------------------------------------------------------

model HistorialAuditoria {
  id        String   @id @default(uuid())

  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId String?

  accion    String   // LOGIN, CREATE, UPDATE, DELETE, etc.
  entidad   String   // nombre de la entidad afectada (Usuario, Copropietario, Expensa...)
  entidadId String?
  detalle   Json?    // payload/diff relevante de la operacion
  ip        String?

  createdAt DateTime @default(now())

  @@map("historial_auditoria")
  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Financiero (Backend 1 - Sprint 0: arquitectura BD)
// Expensas/pagos, ingresos-egresos, caja-bancos y personal.
// Los reportes se calculan a partir de estas tablas, no son una entidad propia.
// ---------------------------------------------------------------------------

enum EstadoExpensa {
  PENDIENTE
  PARCIAL
  PAGADA
  VENCIDA
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CHEQUE
}

enum TipoMovimiento {
  INGRESO
  EGRESO
}

// Cobro mensual de expensas por inmueble
model Expensa {
  id               String        @id @default(uuid())

  inmueble         Inmueble      @relation(fields: [inmuebleId], references: [id])
  inmuebleId       String

  periodo          String        // formato "YYYY-MM"
  montoTotal       Decimal       @db.Decimal(10, 2)
  montoMora        Decimal       @default(0) @db.Decimal(10, 2)
  estado           EstadoExpensa @default(PENDIENTE)
  fechaVencimiento DateTime

  pagos            Pago[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("expensas")
  @@unique([inmuebleId, periodo])
  @@index([periodo])
  @@index([estado])
}

// Pagos aplicados a una expensa (permite pagos parciales)
model Pago {
  id              String     @id @default(uuid())

  expensa         Expensa    @relation(fields: [expensaId], references: [id])
  expensaId       String

  monto           Decimal    @db.Decimal(10, 2)
  metodoPago      MetodoPago
  referencia      String?
  fechaPago       DateTime   @default(now())

  registradoPor   Usuario?   @relation(fields: [registradoPorId], references: [id])
  registradoPorId String?

  @@map("pagos")
  @@index([expensaId])
  @@index([fechaPago])
}

// Ingresos extraordinarios y egresos generales (no ligados a una expensa puntual)
model MovimientoFinanciero {
  id              String         @id @default(uuid())

  tipo            TipoMovimiento
  categoria       String
  monto           Decimal        @db.Decimal(10, 2)
  descripcion     String?
  fecha           DateTime       @default(now())

  registradoPor   Usuario?       @relation(fields: [registradoPorId], references: [id])
  registradoPorId String?

  @@map("movimientos_financieros")
  @@index([tipo])
  @@index([fecha])
}

// Cuentas de banco/caja del edificio
model CuentaBancaria {
  id           String   @id @default(uuid())
  nombre       String
  banco        String
  numeroCuenta String   @unique
  saldoActual  Decimal  @default(0) @db.Decimal(12, 2)

  movimientos  MovimientoCaja[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("cuentas_bancarias")
}

// Movimientos de caja/banco (para conciliacion)
model MovimientoCaja {
  id         String         @id @default(uuid())

  cuenta     CuentaBancaria @relation(fields: [cuentaId], references: [id])
  cuentaId   String

  tipo       TipoMovimiento
  monto      Decimal        @db.Decimal(12, 2)
  concepto   String
  conciliado Boolean        @default(false)
  fecha      DateTime       @default(now())

  @@map("movimientos_caja")
  @@index([cuentaId])
  @@index([fecha])
}

// Personal del edificio (conserjes, seguridad, mantenimiento, etc.)
model Personal {
  id           String   @id @default(uuid())
  nombre       String
  apellido     String
  cargo        String
  salarioBase  Decimal  @db.Decimal(10, 2)
  fechaIngreso DateTime @default(now())
  activo       Boolean  @default(true)

  pagos        PagoPersonal[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("personal")
}

// Historial de pagos de nomina (salarios, bonificaciones, descuentos)
model PagoPersonal {
  id             String   @id @default(uuid())

  personal       Personal @relation(fields: [personalId], references: [id])
  personalId     String

  periodo        String   // formato "YYYY-MM"
  bonificaciones Decimal  @default(0) @db.Decimal(10, 2)
  descuentos     Decimal  @default(0) @db.Decimal(10, 2)
  montoNeto      Decimal  @db.Decimal(10, 2)
  fechaPago      DateTime @default(now())

  registradoPor   Usuario? @relation(fields: [registradoPorId], references: [id])
  registradoPorId String?

  @@map("pagos_personal")
  @@unique([personalId, periodo])
  @@index([personalId])
}
