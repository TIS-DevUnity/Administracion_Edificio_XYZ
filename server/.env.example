# Conexion pooled (usada en runtime por la app, puerto 6543 con pgbouncer en Supabase)
DATABASE_URL="postgresql://postgres:<PASSWORD>@<PROJECT-REF>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexion directa (usada solo por Prisma Migrate, puerto 5432, sin pgbouncer)
DIRECT_URL="postgresql://postgres:<PASSWORD>@<PROJECT-REF>.pooler.supabase.com:5432/postgres"

# Supabase Storage (gestion documental: actas, contratos, facturas, fotos)
SUPABASE_URL="https://<PROJECT-REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"
SUPABASE_STORAGE_BUCKET="documentos-edificio"

# Auth
JWT_SECRET="<GENERAR_UN_SECRETO_LARGO_Y_ALEATORIO>"
JWT_EXPIRES_IN="8h"
BCRYPT_SALT_ROUNDS=10

# Servidor
PORT=4000
NODE_ENV=development

# Correo (notificaciones de expensas generadas y mora aplicada)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="<USUARIO_SMTP>"
SMTP_PASS="<PASSWORD_SMTP>"
SMTP_FROM="Administracion Edificio XYZ <no-reply@example.com>"
# Fuera de produccion (NODE_ENV distinto de "production") los correos NUNCA se envian a los residentes:
# todo va a esta bandeja de pruebas (con el destinatario real en el asunto). Si esta vacia, no se envia nada.
# En produccion no se usa: alli NODE_ENV debe ser "production".
SMTP_REDIRIGIR_A="<CORREO_DE_PRUEBAS>"

# Cron de generacion automatica de expensas / mora
CRON_TIMEZONE="America/La_Paz"

# Caja y bancos (HU7): asientos automaticos de cobros y movimientos, y bloqueo de periodos cerrados.
# Debe quedar en false hasta que la migracion hu7_caja_bancos este aplicada en la base y se haya corrido
# el backfill. Solo el valor "true" lo enciende; con false todo funciona como antes de HU7.
CAJA_BANCOS_ASIENTOS=false